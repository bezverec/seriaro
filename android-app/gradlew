#!/usr/bin/env bash
set -euo pipefail

directory=$(cd "$(dirname "$0")" && pwd)
version=9.9.2
checksum=971fcd7150ca4ba04852c0b2ca0d2d0ab9468e14b03473eab19528809914c76b
if [[ ${SERIES_GRADLE:-} ]]; then
    exec "$SERIES_GRADLE" -p "$directory" "$@"
fi
cache="${XDG_CACHE_HOME:-$HOME/.cache}/seriaro"
gradle="$cache/gradle-$version/bin/gradle"
if [[ ! -x "$gradle" ]]; then
    mkdir -p "$cache"
    temp_dir=$(mktemp -d "$cache/gradle-download.XXXXXXXX")
    trap 'rm -rf "$temp_dir"' EXIT
    archive="$temp_dir/gradle.zip"
    curl --fail --location --silent --show-error \
        "https://downloads.gradle.org/distributions/gradle-$version-bin.zip" -o "$archive"
    if command -v sha256sum >/dev/null; then
        printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --status
    else
        printf '%s  %s\n' "$checksum" "$archive" | shasum -a 256 --check --status
    fi
    unzip -q "$archive" -d "$temp_dir"
    if [[ ! -d "$cache/gradle-$version" ]]; then
        mv "$temp_dir/gradle-$version" "$cache/"
    fi
    rm -rf "$temp_dir"
    trap - EXIT
fi
exec "$gradle" -p "$directory" "$@"
